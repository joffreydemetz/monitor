{
    "name": "jdz/monitor",
    "type": "library",
    "description": "JDZ html formatter for debug",
    "keywords": [
        "JDZ",
        "utilities",
        "html",
        "core"
    ],
    "homepage": "https://jdz.joffreydemetz.com/monitor",
    "license": "MIT",
    "authors": [
        {
            "name": "Joffrey Demetz",
            "email": "joffrey.demetz@gmail.com",
            "homepage": "https://joffreydemetz.com",
            "role": "Lead"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "suggest": {
        "jdz/mailer": "To send the monitoring by mail."
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "jdz/mailer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "JDZ\\Monitor\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JDZ\\Monitor\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always --testdox",
        "test-coverage": ["@putenv XDEBUG_MODE=coverage", "phpunit --coverage-html coverage"]
    }
}
